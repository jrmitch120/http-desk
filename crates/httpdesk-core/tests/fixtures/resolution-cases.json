{
  "about": "Shared by the Rust resolver (tests/resolution_parity.rs) and the frontend provider (src/lib/vars.test.ts); both must give these answers. envFiles are http-client.env.json (public) and http-client.private.env.json (private) at the workspace root; folders holds the same pair for folders below it (by path relative to the root), and dir is the folder of the request's file (default: the root). file is every @name line in the file in order, request is the request's own. In value, a {{$dynamic}} is generated by the core and left as written by the frontend. named is the file's # @names, and exchanges the latest exchange of each one sent (bodies as text). The core reads Request variables from them (coreValue, when given, is its value); the frontend leaves them as written. Only the core reports unsent requests and unmatched paths.",
  "cases": [
    {
      "case": "a request's own @name beats the same name declared elsewhere in the file",
      "file": [
        { "name": "id", "value": "header" },
        { "name": "id", "value": "own" },
        { "name": "id", "value": "a later request" }
      ],
      "request": [{ "name": "id", "value": "own" }],
      "text": "{{id}}",
      "value": "own"
    },
    {
      "case": "a File variable beats the selected environment",
      "envFiles": { "public": { "dev": { "host": "env.example" } } },
      "environment": "dev",
      "file": [{ "name": "host", "value": "file.example" }],
      "text": "https://{{host}}",
      "value": "https://file.example"
    },
    {
      "case": "the selected environment beats the shared variables, which fill its gaps",
      "envFiles": { "public": { "$shared": { "host": "shared.example", "version": "v1" }, "dev": { "host": "dev.example" } } },
      "environment": "dev",
      "text": "{{host}}/{{version}}",
      "value": "dev.example/v1"
    },
    {
      "case": "within an environment the private file overrides the shared file",
      "envFiles": {
        "public": { "$shared": { "region": "eu" }, "dev": { "token": "", "user": "public-user" } },
        "private": { "$shared": { "region": "us" }, "dev": { "token": "s3cret" } }
      },
      "environment": "dev",
      "text": "{{user}}:{{token}}@{{region}}",
      "value": "public-user:s3cret@us"
    },
    {
      "case": "with no environment selected only the shared variables are in scope",
      "envFiles": { "public": { "$shared": { "version": "v1" }, "dev": { "host": "dev.example" } } },
      "environment": null,
      "text": "{{host}}/{{version}}",
      "value": "{{host}}/v1",
      "undefined": ["host"]
    },
    {
      "case": "a nested value is fully resolved",
      "envFiles": { "public": { "dev": { "baseUrl": "{{scheme}}://{{host}}/api", "host": "dev.example" }, "$shared": { "scheme": "https" } } },
      "environment": "dev",
      "text": "{{baseUrl}}/users",
      "value": "https://dev.example/api/users"
    },
    {
      "case": "a nested reference sees the File variable that overrides the environment",
      "envFiles": { "public": { "dev": { "baseUrl": "https://{{host}}/api", "host": "dev.example" } } },
      "environment": "dev",
      "file": [{ "name": "host", "value": "localhost:8080" }],
      "text": "{{ baseUrl }}",
      "value": "https://localhost:8080/api"
    },
    {
      "case": "an undefined variable inside a value is reported by its own name",
      "envFiles": { "public": { "dev": { "baseUrl": "https://{{host}}/api" } } },
      "environment": "dev",
      "text": "{{baseUrl}}/{{id}}",
      "value": "https://{{host}}/api/{{id}}",
      "undefined": ["host", "id"]
    },
    {
      "case": "a cycle is circular, with the chain followed, and not undefined",
      "file": [
        { "name": "a", "value": "{{b}}" },
        { "name": "b", "value": "{{a}}" }
      ],
      "text": "{{a}}",
      "value": "{{a}}",
      "circular": [["a", "b", "a"]]
    },
    {
      "case": "the chain starts at the reference as written",
      "envFiles": { "public": { "dev": { "baseUrl": "https://{{host}}", "host": "{{api}}", "api": "{{host}}" } } },
      "environment": "dev",
      "text": "{{baseUrl}}/users",
      "value": "https://{{host}}/users",
      "circular": [["baseUrl", "host", "api", "host"]]
    },
    {
      "case": "a request variable that refers to its own name is circular, not the environment's value",
      "envFiles": { "public": { "dev": { "host": "dev.example" } } },
      "environment": "dev",
      "file": [{ "name": "host", "value": "{{host}}/v2" }],
      "request": [{ "name": "host", "value": "{{host}}/v2" }],
      "text": "{{host}}",
      "value": "{{host}}/v2",
      "circular": [["host", "host"]]
    },
    {
      "case": "undefined and circular references side by side are each reported once",
      "file": [{ "name": "me", "value": "{{me}}" }],
      "text": "{{me}} {{nope}} {{me}} {{nope}}",
      "value": "{{me}} {{nope}} {{me}} {{nope}}",
      "undefined": ["nope"],
      "circular": [["me", "me"]]
    },
    {
      "case": "the same name used twice in a value is not circular",
      "file": [
        { "name": "h", "value": "x" },
        { "name": "hh", "value": "{{h}}{{h}}" }
      ],
      "text": "{{hh}}",
      "value": "xx"
    },
    {
      "case": "dynamic variables are not looked up, directly or nested",
      "envFiles": { "public": { "dev": { "requestId": "req-{{$randomInt 1 2}}" } } },
      "environment": "dev",
      "file": [{ "name": "base", "value": "https://example.com" }],
      "text": "{{base}}/{{$uuid}}?r={{requestId}}",
      "value": "https://example.com/{{$uuid}}?r=req-{{$randomInt 1 2}}"
    },
    {
      "case": "a $name that isn't a dynamic variable is undefined, as written",
      "text": "{{$nope}}/{{ $env. }}/{{$random.word(3)}}",
      "value": "{{$nope}}/{{ $env. }}/{{$random.word(3)}}",
      "undefined": ["$env.", "$nope", "$random.word(3)"]
    },
    {
      "case": "a prompted value overrides the request, the file and the environment",
      "envFiles": { "public": { "dev": { "token": "env" } } },
      "environment": "dev",
      "file": [{ "name": "token", "value": "file" }],
      "request": [{ "name": "token", "value": "request" }],
      "prompts": [{ "name": "token", "value": "typed" }],
      "text": "Bearer {{token}}",
      "value": "Bearer typed"
    },
    {
      "case": "a prompted value is used inside File variables and environment values that reference it",
      "envFiles": { "public": { "$shared": { "auth": "Bearer {{token}}" }, "dev": { "host": "env.example" } } },
      "environment": "dev",
      "file": [{ "name": "url", "value": "https://{{host}}/x" }],
      "prompts": [{ "name": "host", "value": "typed.example" }, { "name": "token", "value": "t0k" }],
      "text": "{{url}} {{auth}}",
      "value": "https://typed.example/x Bearer t0k"
    },
    {
      "case": "a prompted value is used as typed: references in it are not resolved",
      "file": [{ "name": "host", "value": "file.example" }],
      "prompts": [{ "name": "q", "value": "{{host}}" }],
      "text": "?q={{q}}",
      "value": "?q={{host}}"
    },
    {
      "case": "an unanswered prompt is asked when sent, not undefined, even when defined elsewhere or used inside another value",
      "envFiles": { "public": { "dev": { "otp": "env", "code": "otp={{otp}}" } } },
      "environment": "dev",
      "prompts": [{ "name": "otp" }],
      "text": "{{otp}} {{code}} {{nope}}",
      "value": "{{otp}} otp={{otp}} {{nope}}",
      "undefined": ["nope"],
      "asked": ["otp"]
    },
    {
      "case": "per-directory env files: the nearest folder defining an environment supplies all of it, never merged with a farther one",
      "envFiles": { "public": { "dev": { "host": "root.dev", "port": "1" } } },
      "folders": { "api": { "public": { "dev": { "host": "api.dev" } } } },
      "dir": "api/users",
      "environment": "dev",
      "text": "{{host}}:{{port}}",
      "value": "api.dev:{{port}}",
      "undefined": ["port"]
    },
    {
      "case": "per-directory env files: public and private files are looked up separately, and private wins",
      "envFiles": { "public": { "dev": { "host": "root.dev", "key": "" } }, "private": { "dev": { "key": "root-key" } } },
      "folders": { "service1": { "private": { "dev": { "key": "s1-key" } } } },
      "dir": "service1",
      "environment": "dev",
      "text": "{{host}}?key={{key}}",
      "value": "root.dev?key=s1-key"
    },
    {
      "case": "per-directory env files: the shared variables follow the same nearest-wins rule",
      "envFiles": { "public": { "$shared": { "version": "v1", "region": "eu" } } },
      "folders": { "api": { "public": { "$shared": { "version": "v2" } } } },
      "dir": "api",
      "environment": null,
      "text": "{{version}}/{{region}}",
      "value": "v2/{{region}}",
      "undefined": ["region"]
    },
    {
      "case": "per-directory env files: an environment only a sibling folder defines is never borrowed, the request has no environment",
      "envFiles": { "public": { "$shared": { "version": "v1" } } },
      "folders": { "billing": { "public": { "staging": { "host": "billing.staging" } } }, "users": { "public": { "dev": { "host": "users.dev" } } } },
      "dir": "users",
      "environment": "staging",
      "text": "{{host}}/{{version}}",
      "value": "{{host}}/v1",
      "undefined": ["host"]
    },
    {
      "case": "a reference runs from {{ to the next }}, braces inside included",
      "file": [{ "name": "a", "value": "x" }],
      "text": "{{a{b}} {{ a }}",
      "value": "{{a{b}} x",
      "undefined": ["a{b"]
    },
    {
      "case": "a Request variable reads the latest exchange of the file's request with that # @name",
      "named": ["login"],
      "exchanges": {
        "login": {
          "response": { "headers": [["X-Token", "from-header"]], "body": "{\"token\": \"abc\", \"id\": 7}", "contentType": "application/json" },
          "request": { "headers": [["X-Client", "cli"]], "body": "{\"user\": \"ann\"}", "contentType": "application/json" }
        }
      },
      "text": "Bearer {{login.response.body.$.token}} {{login.response.headers.x-token}} {{login.response.body.$.id}} {{login.request.body.$.user}} {{login.request.headers.X-CLIENT}}",
      "value": "Bearer {{login.response.body.$.token}} {{login.response.headers.x-token}} {{login.response.body.$.id}} {{login.request.body.$.user}} {{login.request.headers.X-CLIENT}}",
      "coreValue": "Bearer abc from-header 7 ann cli"
    },
    {
      "case": "a File variable's value can hold a Request variable",
      "named": ["login"],
      "exchanges": { "login": { "response": { "body": "{\"token\": \"abc\"}", "contentType": "application/json" } } },
      "file": [{ "name": "token", "value": "{{login.response.body.$.token}}" }],
      "text": "{{token}}",
      "value": "{{login.response.body.$.token}}",
      "coreValue": "abc"
    },
    {
      "case": "a Request variable of a request the file has no # @name for is undefined, never the File variable of that name",
      "file": [{ "name": "login", "value": "file-value" }],
      "text": "{{login.response.body.$.token}} {{login.request.headers.X}}",
      "value": "{{login.response.body.$.token}} {{login.request.headers.X}}",
      "undefined": ["login.request.headers.X", "login.response.body.$.token"]
    },
    {
      "case": "a plain reference is the File variable even when a request has that # @name",
      "named": ["login"],
      "exchanges": { "login": { "response": { "body": "{\"token\": \"abc\"}", "contentType": "application/json" } } },
      "file": [{ "name": "login", "value": "file-value" }],
      "text": "{{login}}",
      "value": "file-value"
    },
    {
      "case": "a Request variable of a request not sent in this Session is reported apart from undefined variables",
      "named": ["login"],
      "text": "{{login.response.body.$.token}}",
      "value": "{{login.response.body.$.token}}",
      "unsent": ["login"]
    },
    {
      "case": "a Request variable whose path reads nothing is reported apart from undefined variables",
      "named": ["login"],
      "exchanges": { "login": { "response": { "body": "{\"token\": \"abc\"}", "contentType": "application/json" } } },
      "text": "{{login.response.body.$.nope}} {{login.response.headers.X-Nope}}",
      "value": "{{login.response.body.$.nope}} {{login.response.headers.X-Nope}}",
      "unmatched": ["login.response.body.$.nope", "login.response.headers.X-Nope"]
    }
  ]
}
