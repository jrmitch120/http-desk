# Generated by HttpDesk from "Swagger Petstore" 1.0.0
# pet: Everything about your Pets
@petId = 42

### List all pets
# Returns all pets the caller can see.
#
# Supports paging.
# @name listPets
GET {{baseUrl}}/pets?status=available
#~ &limit=20
Authorization: Bearer {{token}}
Accept: application/json
#~ X-Request-ID: 3fa85f64-5717-4562-b3fc-2c963f66afa6
X-Trace: trace-1

### Create a pet
# @name createPet
POST {{baseUrl}}/pets
Authorization: Basic {{username}} {{password}}
Accept: application/json
Content-Type: application/json

{
  "name": "Rex",
  "tag": "string",
  "birthday": "2024-01-01"
}

### Info for a specific pet
# @name showPetById
# @httpdesk-auth apikey header X-API-Key
GET {{baseUrl}}/pets/{{petId}}
X-API-Key: {{api_key}}
Accept: application/json

### deletePet
# DEPRECATED
# @name deletePet
DELETE {{baseUrl}}/pets/{{petId}}
Authorization: Bearer {{token}}
#~ Cookie: session=abc123

### Upload a photo
# @name uploadPhoto
POST {{baseUrl}}/pets/{{petId}}/photo
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="caption"

Rex at the beach
--WebAppBoundary
Content-Disposition: form-data; name="metadata"
Content-Type: application/json

{"takenAt":"2024-01-01T12:00:00Z"}
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="file.png"
Content-Type: image/png

< ./file.png
--WebAppBoundary--
