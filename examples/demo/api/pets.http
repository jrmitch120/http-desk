@petId = 10

### List pets
# Returns the pets with the given status.
# @param status: available, pending or sold.
GET {{baseUrl}}/pet/findByStatus?status=available
Accept: application/json
#~ X-Debug: true

### Create pet
# Adds pet {{petId}}, or replaces it if it exists.
POST {{baseUrl}}/pet
Content-Type: application/json
Accept: application/json

{
  "id": {{petId}},
  "name": "Rex",
  "photoUrls": [],
  "status": "available"
}

### Get pet
# The public Petstore is shared and resets now and then, so pets come and go.
# If this returns 404, send "Create pet" first.
GET {{baseUrl}}/pet/{{petId}}
Accept: application/json
